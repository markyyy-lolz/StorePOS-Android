<Window x:Class="StorePOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StorePOS Windows · Azurate" Width="1480" Height="920"
        MinWidth="1160" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#0C1422" Foreground="#E2E8F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Desktop header -->
        <Border Grid.Row="0" Background="#121E30" BorderBrush="#283753" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="StorePOS" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="WINDOWS  •  v1.0.0" FontSize="10" Foreground="#93B6EA" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ShopName" Text="Your Store Workspace" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseText" Text="Sign in to load your StorePOS license" Foreground="#9FB0CB" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ConnectionText" Text="● STARTING" FontWeight="Bold" FontSize="12"
                               Foreground="#F5C16C" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="OperatorText" Text="No active session" FontSize="12" Foreground="#92A6C5"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#121E30" BorderBrush="#263652" BorderThickness="0,0,1,0">
                <StackPanel Margin="16,24,14,12">
                    <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#87A5C8" Margin="8,4,0,14"/>
                    <Button Content="▣  Point of Sale" Click="OpenPos" HorizontalContentAlignment="Left" Height="50"/>
                    <Button Content="▤  Inventory" Click="OpenInventory" HorizontalContentAlignment="Left"
                            Background="#223754" Height="50"/>
                    <Button Content="▥  Sales &amp; Sync" Click="OpenHistory" HorizontalContentAlignment="Left"
                            Background="#223754" Height="50"/>
                    <Button Content="⚙  Settings &amp; License" Click="OpenSettings" HorizontalContentAlignment="Left"
                            Background="#223754" Height="50"/>
                    <Border Height="1" Background="#314361" Margin="8,26,8,20"/>
                    <TextBlock Text="HYBRID MODE" FontSize="11" FontWeight="Bold" Foreground="#87A5C8" Margin="8,0,0,8"/>
                    <TextBlock Text="Sales are always saved locally first. Cloud sync retries safely when connected."
                               Foreground="#ACC0DB" FontSize="12" TextWrapping="Wrap" Margin="8"/>
                    <Button Content="↻  Sync Now" Background="#236F8B" Click="SyncNow_Click" Height="44" Margin="2,20,2,4"/>
                    <TextBlock x:Name="PendingSidebar" Text="No transactions pending" Margin="8,4"
                               Foreground="#9FB4D5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TabControl x:Name="Pages" Grid.Column="1" Background="#0C1422"
                        BorderThickness="0" Foreground="#E2E8F0" Margin="18,8,18,12">
                <TabItem Header="Cashier">
                    <Grid Margin="14,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Checkout" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchInput" Width="310" Margin="18,0,0,0"
                                     ToolTip="Find by barcode, SKU, or product name. Enter adds a match."
                                     KeyDown="SearchInput_KeyDown"/>
                            <Button Content="Find" Click="FindProducts_Click" Width="76"/>
                            <TextBox x:Name="QuantityInput" Text="1" Width="50"
                                     ToolTip="Quantity (whole units)"/>
                            <Button Content="+ Add to Cart" Click="AddToCart_Click" Width="125"/>
                        </StackPanel>
                        <DataGrid x:Name="ProductsGrid" Grid.Row="1" IsReadOnly="True"
                                  AutoGenerateColumns="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                <DataGridTextColumn Header="Selling" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="Local stock" Binding="{Binding Stock}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Grid.RowSpan="2" Background="#17263D" CornerRadius="16" Margin="16,0,0,0" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CURRENT CART" FontSize="13" FontWeight="Bold" Foreground="#8DAFDA"/>
                                    <TextBlock x:Name="CartCount" Text="0 items" Foreground="#ACBDDC" Margin="0,6,0,12"/>
                                </StackPanel>
                                <DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0,4,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="*"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="2" Content="Remove selected item" Click="RemoveCart_Click" Background="#455875"/>
                                <StackPanel Grid.Row="3" Margin="0,12,0,12">
                                    <TextBlock x:Name="TotalText" Text="TOTAL  PHP 0.00" FontSize="25" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <TextBlock Text="Cash tendered" Width="118" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TenderInput" Width="155" Text="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Cash only while offline • synced totals are reconciled by cloud"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#A6B8D6" Margin="0,9,0,0"/>
                                </StackPanel>
                                <Button x:Name="CheckoutButton" Grid.Row="4" Content="COMPLETE CASH SALE"
                                        FontSize="15" FontWeight="Bold" Height="57" Click="Checkout_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Inventory">
                    <Grid Margin="14,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Inventory Manager" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  LOCAL + CLOUD" Foreground="#8AA6CB"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid x:Name="InventoryGrid" Grid.Row="1" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding Stock}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Background="#17263D" Padding="13" CornerRadius="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Stock adjustments / physical count" FontWeight="Bold" FontSize="15" Margin="4,0,0,8"/>
                                <WrapPanel>
                                    <TextBox x:Name="StockDeltaInput" Width="95" ToolTip="Enter +10 for restock, -2 for deduction"/>
                                    <ComboBox x:Name="StockReasonInput" Width="125" SelectedIndex="0" Margin="4" Background="#253650">
                                        <ComboBoxItem Content="adjustment"/><ComboBoxItem Content="return"/>
                                        <ComboBoxItem Content="damage"/><ComboBoxItem Content="theft"/>
                                        <ComboBoxItem Content="opening"/>
                                    </ComboBox>
                                    <TextBox x:Name="StockNoteInput" Width="200" ToolTip="Optional reason or supplier note"/>
                                    <Button Content="Save Adjustment" Click="AdjustStock_Click"/>
                                    <TextBox x:Name="CountInput" Width="95" ToolTip="Absolute physical count"/>
                                    <Button Content="Save Stocktake" Click="Stocktake_Click" Background="#236F8B"/>
                                </WrapPanel>
                                <TextBlock Text="Add product / edit selected product" FontWeight="Bold" FontSize="15" Margin="4,12,0,8"/>
                                <WrapPanel>
                                    <TextBox x:Name="SkuInput" Width="140" ToolTip="New SKU"/>
                                    <TextBox x:Name="NameInput" Width="175" ToolTip="New product name or edited name"/>
                                    <TextBox x:Name="PriceInput" Width="105" ToolTip="Selling price in PHP"/>
                                    <TextBox x:Name="OpeningInput" Width="95" ToolTip="Opening quantity for new product"/>
                                    <Button Content="Add Product" Click="AddProduct_Click"/>
                                    <Button Content="Edit Selected" Click="EditProduct_Click" Background="#236F8B"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Sales &amp; Sync">
                    <Grid Margin="14,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Local Transaction History" FontSize="24" FontWeight="Bold"/>
                            <Button Content="Sync Pending" Click="SyncNow_Click" Margin="20,0,0,0"/>
                            <Button Content="Reprint Selected" Click="Reprint_Click" Background="#455875"/>
                        </StackPanel>
                        <DataGrid x:Name="OutboxGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Recorded" Binding="{Binding CreatedAt}" Width="2*"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="Original staff" Binding="{Binding ActorId}" Width="2*"/>
                                <DataGridTextColumn Header="Transaction ID" Binding="{Binding Id}" Width="3*"/>
                                <DataGridTextColumn Header="Sync issue" Binding="{Binding Error}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Receipt preview (local saved bytes remain available after successful cloud sync)"
                                   Margin="0,4" FontWeight="Bold"/>
                        <TextBox x:Name="ReceiptText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,28" MaxWidth="850" HorizontalAlignment="Left">
                            <TextBlock Text="Settings &amp; Device License" FontSize="25" FontWeight="Bold" Margin="0,0,0,20"/>
                            <TextBlock Text="WINDOWS PRINTER NAME" Foreground="#8BA9D0" FontWeight="Bold"/>
                            <TextBox x:Name="PrinterInput" Width="480" HorizontalAlignment="Left"
                                     ToolTip="Exact name of the printer installed in Windows Settings → Printers &amp; scanners"/>
                            <CheckBox x:Name="AutoPrintInput" Content="Automatically print after each saved cash checkout"
                                      Foreground="#F2F6FC" IsChecked="True" Margin="4,10,0,20"/>
                            <Button Content="Save printer settings" Click="SavePrinter_Click"
                                    Width="220" HorizontalAlignment="Left"/>
                            <TextBlock Text="PRINT WIDTH" Foreground="#8BA9D0" FontWeight="Bold" Margin="0,18,0,4"/>
                            <ComboBox x:Name="PaperWidthInput" Width="120" HorizontalAlignment="Left"
                                      SelectedIndex="1" Background="#253650">
                                <ComboBoxItem Content="58 mm"/><ComboBoxItem Content="80 mm"/>
                            </ComboBox>
                            <Border Background="#182A44" CornerRadius="12" Padding="16" Margin="0,24,0,18">
                                <StackPanel>
                                    <TextBlock Text="Device activation" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock x:Name="DeviceIdText" Text="Not initialized" Margin="0,9,0,5" TextWrapping="Wrap"/>
                                    <TextBlock Text="StorePOS Windows requires a separate authorized device seat. Activation must be done while online."
                                               TextWrapping="Wrap" Foreground="#A7BCD9" Margin="0,0,0,12"/>
                                    <PasswordBox x:Name="ActivationInput" Width="350" HorizontalAlignment="Left" Margin="0,0,0,9"/>
                                    <Button Content="Activate this Windows device" Click="Activate_Click"
                                            HorizontalAlignment="Left" Width="256"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Sign out (preserves local unsynced records)" Click="SignOut_Click"
                                    Width="335" HorizontalAlignment="Left" Background="#9A3543"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#132137" BorderBrush="#293B55" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#B6C7DF" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="Azurate Software Solutions · StorePOS Windows v1.0.0"
                           Foreground="#889CB7" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Login overlays the application until authenticated and licensed. -->
        <Grid x:Name="LoginOverlay" Grid.RowSpan="3" Background="#EE0A1425">
            <Border Width="510" Padding="32" CornerRadius="22" Background="#182740"
                    BorderBrush="#304566" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="StorePOS" FontSize="36" FontWeight="Bold"/>
                    <TextBlock Text="Windows Desktop  ·  Azurate" Foreground="#97BCED"
                               FontSize="14" Margin="0,2,0,22"/>
                    <TextBlock Text="StorePOS account email" FontWeight="SemiBold"/>
                    <TextBox x:Name="EmailInput" Height="38" Margin="0,6,0,12"/>
                    <TextBlock Text="Password" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="PasswordInput" Height="38" Margin="0,6,0,12"/>
                    <TextBlock Text="StorePOS Secure Verification" FontWeight="SemiBold"/>
                    <Border Background="White" CornerRadius="10" Height="150" Margin="0,7,0,7">
                        <wv2:WebView2 x:Name="CaptchaWeb"/>
                    </Border>
                    <TextBlock x:Name="CaptchaStateText" Text="Loading StorePOS Cloudflare Turnstile..."
                               FontSize="11" Foreground="#A3BEDC" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="↻ Refresh security verification" Click="ReloadCaptcha_Click"
                            Background="#314D70" Height="32" Margin="0,0,0,10"/>
                    <TextBlock Text="Captcha token (automatically populated, if verified)"
                               FontSize="11" Foreground="#AEC2E2"/>
                    <TextBox x:Name="CaptchaInput" Height="38" Margin="0,5,0,14"/>
                    <Button x:Name="SignInButton" Content="SIGN IN &amp; CHECK LICENSE"
                            Height="50" Click="SignIn_Click" FontSize="15"/>
                    <Button Content="Open saved offline session" Click="OpenOffline_Click" Margin="0,12,0,0"
                            Height="42" Background="#314D70"/>
                    <TextBlock x:Name="LoginError" Foreground="#FFA6A6" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <TextBlock Text="First use needs internet for login, shop verification, device activation, and product catalog download. Cached offline access follows your license grace period."
                               TextWrapping="Wrap" FontSize="12" Foreground="#A5B8D4" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
