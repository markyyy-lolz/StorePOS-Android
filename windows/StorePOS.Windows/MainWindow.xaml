<Window x:Class="StorePOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StorePOS for Windows" Width="1500" Height="900" MinWidth="1160" MinHeight="730"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Quiet, compact retail header instead of the old large dark masthead. -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F1" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2463DC" CornerRadius="9" Height="39" Width="39" VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="White" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StorePOS" FontSize="20" FontWeight="Bold" Foreground="#172338"/>
                        <TextBlock Text="WINDOWS • v1.0.1" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#71839B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="ShopName" Text="Your Store Workspace" FontSize="17"
                               FontWeight="SemiBold" Foreground="#1B2C44"/>
                    <TextBlock x:Name="LicenseText" Text="Sign in to verify your StorePOS license"
                               FontSize="11" Foreground="#8A5F28" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF9F4" BorderBrush="#CFEDDD" BorderThickness="1" CornerRadius="14"
                            Padding="11,7" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionText" Text="● STARTING" Foreground="#157552"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="OperatorText" Text="No active session" FontWeight="SemiBold"
                                   FontSize="12" TextAlignment="Right" Foreground="#3F5069"/>
                        <TextBlock Text="StorePOS Retail Workspace" FontSize="10" TextAlignment="Right"
                                   Foreground="#8696AC" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,0,1,0">
                <Grid Margin="14,20,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="WORKSPACE" Foreground="#9BA8B9" FontSize="10"
                               FontWeight="Bold" Margin="14,0,0,14"/>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="PosNavButton" Content="▦    Point of Sale" Click="OpenPos"
                                Style="{StaticResource NavSelectedButton}"/>
                        <Button x:Name="InventoryNavButton" Content="▤    Inventory" Click="OpenInventory"
                                Style="{StaticResource NavButton}"/>
                        <Button x:Name="HistoryNavButton" Content="▥    Sales &amp; Sync" Click="OpenHistory"
                                Style="{StaticResource NavButton}"/>
                        <Button x:Name="SettingsNavButton" Content="⚙    Settings" Click="OpenSettings"
                                Style="{StaticResource NavButton}"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#F3F7FC" CornerRadius="12" Padding="12"
                            BorderBrush="#E5EBF3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="HYBRID SYNC" Foreground="#667D9B" FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="PendingSidebar" Text="0 pending • 0 needs review"
                                       Foreground="#2A3B53" FontSize="12" Margin="0,9,0,8"
                                       TextWrapping="Wrap"/>
                            <Button Content="↻  Sync now" Click="SyncNow_Click" Height="39"
                                    Background="#E0EAFA" Foreground="#1852B5"/>
                            <TextBlock Text="F5 to synchronize" FontSize="10" Foreground="#90A0B4"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Nav buttons select content in code, but visual TabItem headers are hidden. -->
            <TabControl x:Name="Pages" Grid.Column="1" Background="Transparent"
                        BorderThickness="0" Padding="0" Margin="0" Foreground="#172338"
                        SelectionChanged="Pages_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Border Background="Transparent">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="Point of Sale">
                    <Grid Margin="24,20,24,19">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Point of Sale" FontSize="25" FontWeight="Bold"
                                           Foreground="#1B2B42"/>
                                <TextBlock Text="Scan products and process cash sales, even without internet."
                                           FontSize="12" Foreground="#708197" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="8" BorderBrush="#D6E5FB" BorderThickness="1"
                                    Background="#EAF2FF" Padding="12,8" VerticalAlignment="Center">
                                <TextBlock Text="F2  Search       F4  Checkout       F5  Sync"
                                           Foreground="#2C61A7" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="370"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="13"
                                    BorderBrush="#E1E7EF" BorderThickness="1" Padding="17">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="13"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Products" FontWeight="Bold" FontSize="17"/>
                                            <TextBlock x:Name="ProductsCountText" Text="Browse your store catalog"
                                                       Foreground="#8090A4" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F3F6FB" CornerRadius="9"
                                                VerticalAlignment="Center" Padding="10,6">
                                            <TextBlock Text="USB barcode scanner ready" Foreground="#647895"
                                                       FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌕" Foreground="#8294A9" FontSize="20"
                                                   VerticalAlignment="Center" Margin="5,0,6,0"/>
                                        <TextBox x:Name="SearchInput" Grid.Column="1" Height="40"
                                                 ToolTip="Scan a barcode or enter a product name / SKU and press Enter."
                                                 KeyDown="SearchInput_KeyDown"/>
                                        <Button Grid.Column="2" Content="Find" Click="FindProducts_Click"
                                                Style="{StaticResource GhostButton}" Padding="16,8"/>
                                        <TextBox x:Name="QuantityInput" Grid.Column="3" Text="1" Width="52"
                                                 ToolTip="Quantity of selected item"/>
                                        <Button Grid.Column="4" Content="+ Add" Click="AddToCart_Click"
                                                Padding="17,8"/>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <DataGrid x:Name="ProductsGrid" BorderThickness="1" AlternationCount="2"
                                                  AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ITEM DESCRIPTION" Binding="{Binding Name}" Width="2.2*"/>
                                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.15*"/>
                                                <DataGridTextColumn Header="PRICE (₱)" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="0.95*"/>
                                                <DataGridTextColumn Header="STOCK" Binding="{Binding Stock, StringFormat={}{0:N0}}" Width="0.72*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel x:Name="ProductsEmptyState" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Margin="25" IsHitTestVisible="False">
                                            <TextBlock Text="▣" FontSize="34" Foreground="#A9BAD0"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="No products to display" FontSize="15" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,13,0,0"/>
                                            <TextBlock Text="Activate this device and sync the product catalog, or try another search."
                                                       Foreground="#8496AC" FontSize="11" Margin="0,6,0,0"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="5" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Select a row, then Add • Barcode + Enter for quick checkout"
                                                   Foreground="#93A2B5" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="LOCAL CATALOG" Foreground="#95A3B4"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="13"
                                    BorderBrush="#DDE6F0" BorderThickness="1" Padding="17">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Current Sale" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock x:Name="CartCount" Text="0 product lines"
                                                       Foreground="#8496AC" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#E7F6EF" CornerRadius="8"
                                                Padding="9,5" VerticalAlignment="Center">
                                            <TextBlock Text="CASH" Foreground="#148060" FontWeight="Bold"
                                                       FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    <DataGrid Grid.Row="2" x:Name="CartGrid" BorderThickness="0,1,0,1"
                                              Background="White" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="1.8*"/>
                                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="0.55*"/>
                                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="1.05*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Grid.Row="3" Content="Remove selected item"
                                            Style="{StaticResource OutlineButton}" Click="RemoveCart_Click"
                                            HorizontalAlignment="Right" FontSize="11" Margin="0,11,0,11"/>
                                    <Border Grid.Row="4" Background="#F5F8FD" CornerRadius="11" Padding="14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Subtotal" Foreground="#6E8098" FontSize="12"/>
                                                <TextBlock x:Name="SubtotalText" Grid.Column="1" Text="₱0.00"
                                                           FontWeight="SemiBold" FontSize="12"/>
                                            </Grid>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tax" Foreground="#6E8098" FontSize="12"/>
                                                <TextBlock x:Name="TaxText" Grid.Column="1" Text="₱0.00"
                                                           FontWeight="SemiBold" FontSize="12"/>
                                            </Grid>
                                            <Border Height="1" Background="#DDE5EF" Margin="0,13"/>
                                            <TextBlock Text="AMOUNT DUE" Foreground="#647A97"
                                                       FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TotalText" Text="₱0.00" Foreground="#1B3E79"
                                                       FontSize="32" FontWeight="Bold" Margin="0,2,0,9"/>
                                            <TextBlock Text="Cash received" Foreground="#536985" FontSize="11"/>
                                            <TextBox x:Name="TenderInput" Text="0" FontSize="16"
                                                     FontWeight="SemiBold" Height="42"
                                                     TextChanged="TenderInput_TextChanged"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Change" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="#687D96"/>
                                                <TextBlock x:Name="ChangeText" Grid.Column="1"
                                                           Text="₱0.00" FontSize="17"
                                                           Foreground="#13805F" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="5">
                                        <Button x:Name="CheckoutButton" Content="Complete Cash Sale  →"
                                                Click="Checkout_Click" FontSize="15" FontWeight="Bold"
                                                Height="53" Margin="0,14,0,0"/>
                                        <TextBlock Text="Saved locally before printing • Uploads when online"
                                                   TextAlignment="Center" Foreground="#93A3B7"
                                                   FontSize="10" Margin="0,9,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Inventory">
                    <Grid Margin="24,21,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Inventory" FontSize="25" FontWeight="Bold"/>
                            <TextBlock Text="Update stock and products locally; changes synchronize when connected."
                                       Foreground="#708197" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" CornerRadius="13" Background="White" BorderBrush="#E1E7EF"
                                BorderThickness="1" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Product catalog" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" x:Name="InventoryCountText" Text="0 products"
                                               Foreground="#8798AC" FontSize="12"/>
                                </Grid>
                                <DataGrid Grid.Row="2" x:Name="InventoryGrid" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                        <DataGridTextColumn Header="BARCODE" Binding="{Binding Barcode}" Width="*"/>
                                        <DataGridTextColumn Header="PRICE (₱)" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="*"/>
                                        <DataGridTextColumn Header="STOCK" Binding="{Binding Stock, StringFormat={}{0:N0}}" Width="0.8*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="12"
                                    BorderBrush="#E1E7EF" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Stock movement &amp; count" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Select a product above. Queues automatically while offline."
                                               Foreground="#8090A4" FontSize="11" Margin="0,4,0,8"/>
                                    <WrapPanel>
                                        <TextBox x:Name="StockDeltaInput" Width="92" ToolTip="Delta, e.g. +10 or -2"/>
                                        <ComboBox x:Name="StockReasonInput" Width="125" SelectedIndex="0">
                                            <ComboBoxItem Content="adjustment"/><ComboBoxItem Content="return"/>
                                            <ComboBoxItem Content="damage"/><ComboBoxItem Content="theft"/>
                                            <ComboBoxItem Content="opening"/>
                                        </ComboBox>
                                        <TextBox x:Name="StockNoteInput" Width="150" ToolTip="Movement note"/>
                                        <Button Content="Apply movement" Click="AdjustStock_Click"
                                                Style="{StaticResource GhostButton}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,7,0,0">
                                        <TextBlock Text="Physical count" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="#5F748E" Margin="2,0,7,0"/>
                                        <TextBox x:Name="CountInput" Width="99" ToolTip="Absolute counted stock"/>
                                        <Button Content="Save stocktake" Click="Stocktake_Click"
                                                Style="{StaticResource GhostButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="12"
                                    BorderBrush="#E1E7EF" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Product details" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Create a product or edit the selected item. Stock changes use movements."
                                               Foreground="#8090A4" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <TextBox x:Name="SkuInput" Width="110" ToolTip="SKU (new product)"/>
                                        <TextBox x:Name="NameInput" Width="150" ToolTip="Product name"/>
                                        <TextBox x:Name="PriceInput" Width="92" ToolTip="Selling price"/>
                                        <TextBox x:Name="OpeningInput" Width="87" ToolTip="Opening stock"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="+ Add product" Click="AddProduct_Click"/>
                                        <Button Content="Edit selected" Click="EditProduct_Click"
                                                Style="{StaticResource GhostButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Sales &amp; Sync">
                    <Grid Margin="24,21,24,19">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sales &amp; synchronization" FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="Local sales, original receipts, pending uploads, and stock conflicts."
                                           FontSize="12" Foreground="#708197" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="↻  Sync pending" Click="SyncNow_Click"/>
                                <Button Content="▤  Reprint selected" Click="Reprint_Click"
                                        Style="{StaticResource OutlineButton}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Background="White" BorderBrush="#E1E7EF"
                                BorderThickness="1" CornerRadius="12" Padding="15">
                            <DataGrid x:Name="OutboxGrid" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOCAL DATE" Binding="{Binding CreatedAt}" Width="1.7*"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="0.8*"/>
                                    <DataGridTextColumn Header="SYNC STATUS" Binding="{Binding Status}" Width="*"/>
                                    <DataGridTextColumn Header="STAFF ID" Binding="{Binding ActorId}" Width="1.8*"/>
                                    <DataGridTextColumn Header="TRANSACTION ID" Binding="{Binding Id}" Width="2.6*"/>
                                    <DataGridTextColumn Header="ISSUE / NOTE" Binding="{Binding Error}" Width="2.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Row="4" Background="White" CornerRadius="12"
                                BorderBrush="#E1E7EF" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Saved receipt preview" FontWeight="Bold" FontSize="13" Margin="4,0,0,8"/>
                                <TextBox x:Name="ReceiptText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" Background="#FAFBFD"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,21,24,20">
                        <StackPanel MaxWidth="870" HorizontalAlignment="Left">
                            <TextBlock Text="Settings &amp; license" FontSize="25" FontWeight="Bold"/>
                            <TextBlock Text="Local printer configuration and Windows device activation."
                                       FontSize="12" Foreground="#708197" Margin="0,5,0,20"/>
                            <Border Background="White" CornerRadius="13" BorderBrush="#E1E7EF"
                                    BorderThickness="1" Padding="23" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Receipt printer" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="Exact printer name from Windows Settings → Printers &amp; scanners"
                                               FontSize="12" Foreground="#8393A7" Margin="0,5,0,14"/>
                                    <TextBlock Text="WINDOWS PRINTER NAME" FontSize="10" FontWeight="Bold"
                                               Foreground="#60728A"/>
                                    <TextBox x:Name="PrinterInput" Width="460" HorizontalAlignment="Left"
                                             Margin="0,7,0,12"/>
                                    <CheckBox x:Name="AutoPrintInput"
                                              Content="Automatically print after saving each cash sale"
                                              IsChecked="True" Margin="0,0,0,15"/>
                                    <TextBlock Text="PAPER WIDTH" FontSize="10" FontWeight="Bold"
                                               Foreground="#60728A"/>
                                    <ComboBox x:Name="PaperWidthInput" Width="145" HorizontalAlignment="Left"
                                              SelectedIndex="1" Margin="0,7,0,15">
                                        <ComboBoxItem Content="58 mm"/>
                                        <ComboBoxItem Content="80 mm"/>
                                    </ComboBox>
                                    <Button Content="Save printer settings" Click="SavePrinter_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="13" BorderBrush="#E1E7EF"
                                    BorderThickness="1" Padding="23" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Device activation" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock x:Name="DeviceIdText" Text="Not initialized" FontSize="12"
                                               Foreground="#526B8D" Margin="0,12,0,5" TextWrapping="Wrap"/>
                                    <TextBlock Text="Windows requires its own authorized StorePOS license seat. Activation requires internet."
                                               Foreground="#8595A7" FontSize="12" Margin="0,2,0,12"
                                               TextWrapping="Wrap"/>
                                    <PasswordBox x:Name="ActivationInput" Width="400"
                                                 HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <Button Content="Activate Windows device" Click="Activate_Click"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Sign out (keep local unsynced records)" Click="SignOut_Click"
                                    Background="#FBEAEC" Foreground="#A53646" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3E9F1" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"
                           Foreground="#68819B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="StorePOS Windows 1.0.1  •  Azurate Software Solutions"
                           FontSize="10" Foreground="#9CAABA" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- White sign-in modal, keeping real Supabase Auth and hosted Turnstile. -->
        <Grid x:Name="LoginOverlay" Grid.RowSpan="3" Background="#C51C2E47">
            <Border Width="480" Padding="30" CornerRadius="16" Background="White"
                    BorderBrush="#DDE7F2" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="740">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="#2463DC" CornerRadius="9" Width="42" Height="42">
                                <TextBlock Text="S" Foreground="White" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Welcome to StorePOS" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="Windows Desktop Edition" Foreground="#788CA6" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Work email" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox x:Name="EmailInput" Height="39" Margin="0,7,0,13"/>
                        <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12"/>
                        <PasswordBox x:Name="PasswordInput" Height="39" Margin="0,7,0,13"/>
                        <TextBlock Text="Secure verification" FontWeight="SemiBold" FontSize="12"/>
                        <Border BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="9"
                                Height="123" Margin="0,7,0,7" Background="White">
                            <wv2:WebView2 x:Name="CaptchaWeb"/>
                        </Border>
                        <TextBlock x:Name="CaptchaStateText"
                                   Text="Loading StorePOS security verification..."
                                   Foreground="#60758F" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,7"/>
                        <Button Content="↻ Refresh verification" Click="ReloadCaptcha_Click"
                                Style="{StaticResource GhostButton}" Margin="0,0,0,9"/>
                        <TextBlock Text="Security token (filled automatically)" Foreground="#8292A6"
                                   FontSize="11"/>
                        <PasswordBox x:Name="CaptchaInput" Height="35" Margin="0,6,0,12"/>
                        <Button x:Name="SignInButton" Content="Sign In &amp; Verify License"
                                Click="SignIn_Click" FontSize="14" Height="47"/>
                        <Button Content="Open saved offline session" Click="OpenOffline_Click"
                                Style="{StaticResource OutlineButton}" Height="41" Margin="0,10,0,0"/>
                        <TextBlock x:Name="LoginError" Foreground="#B24148" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Initial setup needs internet. Later, offline access follows your approved license grace period."
                                   Foreground="#90A0B3" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
