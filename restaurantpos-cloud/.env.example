# Set secrets only in your deployment environment; never commit a real .env.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/restaurantpos?sslmode=require
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://restaurantpos.example.com

# OWNER_* values are needed only to run npm run setup ONE TIME, then remove.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
RESTAURANT_NAME=

# Optional; require BOTH for verified hosted checkout. Start with sk_test_.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
